# TCP radar ingest
TCP_LISTEN_ADDR=:9101
MAX_TCP_CONNECTIONS=16

# REST API
HTTP_LISTEN_ADDR=:8080

# Redis recent-echo cache (10 minute retention)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
ECHO_TTL=10m

# PostgreSQL
POSTGRES_DSN=postgres://ice:ice@localhost:5432/iceradar?sslmode=disable

# Ice analysis tuning (echo intensity 0..255)
ICE_THRESHOLD=100
RIDGE_THRESHOLD=170
RIDGE_MIN_BINS=3
